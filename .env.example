# SEC requires a descriptive User-Agent with contact info on every request.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="messy-filings-rag research contact@example.com"

# Answer LLM. Set ONE of these; the provider is chosen from whichever key is present.
GROQ_API_KEY=
GEMINI_API_KEY=

# Query router (Step 11). Optional: without it the app falls back to the
# hand-written phrase list, which is the default and needs no credential.
TYPESAFE_API_KEY=
